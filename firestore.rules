rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each user (including anonymous guests) can only read/write their own data.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /cart/{itemId} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.qty is int
          && request.resource.data.qty > 0 && request.resource.data.qty <= 500;
      }
      match /orders/{orderId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create: if request.auth != null && request.auth.uid == uid
          && request.resource.data.uid == uid;
        allow update, delete: if false; // orders are immutable from the client
      }
      match /searches/{searchId} {
        allow read, create, delete: if request.auth != null && request.auth.uid == uid;
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
