# Firebase web config (Firebase console > Project settings > Your apps > Web app)
# Leave these empty to run in clearly-labelled DEMO MODE (simulated AI, local storage).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check (required by Firebase AI Logic). Use ONE of:
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=
VITE_RECAPTCHA_V3_SITE_KEY=
# For local dev only: "true" prints a debug token in the console to register in Firebase console.
# Or paste an already-registered debug token. Never commit a real token.
VITE_APPCHECK_DEBUG_TOKEN=

# Optional: cloud model override (Remote Config key `cloud_model` wins if set)
VITE_CLOUD_MODEL=gemini-3.5-flash-lite
